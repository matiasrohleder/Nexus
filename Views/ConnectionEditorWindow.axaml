<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Nexus.ViewModels"
        xmlns:prov="using:Nexus.Providers"
        xmlns:c="using:Nexus.Controls"
        x:Class="Nexus.Views.ConnectionEditorWindow"
        x:DataType="vm:ConnectionEditorViewModel"
        Width="540" Height="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Icon="/Assets/nexus.ico"
        Background="#1E1E1E"
        Title="{Binding DialogTitle}">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.swatch">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.swatch.selected">
            <Setter Property="BorderBrush" Value="White" />
        </Style>
        <Style Selector="Button.swatch.selected /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="White" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <TextBlock Grid.Row="0" Text="{Binding DialogTitle}" Margin="22 18 22 10"
                   FontSize="18" FontWeight="SemiBold" />

        <!-- Inset via the content's Margin, not ScrollViewer.Padding: the padding isn't subtracted when
             measuring, so long values (file paths) pushed the Browse button off the right edge. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14" Margin="22 0 22 8">

                <!-- Engine tiles -->
                <StackPanel Spacing="6">
                    <TextBlock Classes="label" Text="Database engine" />
                    <ListBox ItemsSource="{Binding Engines}"
                             SelectedItem="{Binding SelectedEngine}"
                             Background="Transparent" Padding="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0 0 6 6" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="Background" Value="#252526" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="prov:IDatabaseProvider">
                                <StackPanel Orientation="Vertical" Width="88" Height="62" Spacing="6"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <c:EngineLogo Engine="{Binding Id}" Brand="{Binding BrandColor}" Size="24"
                                                  HorizontalAlignment="Center" Margin="0 7 0 0" />
                                    <TextBlock Text="{Binding DisplayName}" FontSize="11"
                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- Paste URL -->
                <StackPanel Spacing="5">
                    <TextBlock Classes="label" Text="Quick fill — paste a connection URL or string" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding PasteUrl}"
                                 PlaceholderText="postgres://user:pass@host:5432/db" />
                        <Button Grid.Column="1" Content="Apply" Margin="6 0 0 0" Classes="toolbar"
                                Command="{Binding ApplyPastedUrlCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding PasteUrlError}" Foreground="#F48771" FontSize="12"
                               IsVisible="{Binding PasteUrlError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <Border Height="1" Background="#333337" Margin="0 2" />

                <StackPanel Spacing="5">
                    <TextBlock Classes="label" Text="Name" />
                    <TextBox Text="{Binding Name}" PlaceholderText="Auto-generated if left empty" />
                </StackPanel>

                <!-- File-based engines: file picker -->
                <StackPanel Spacing="5" IsVisible="{Binding IsFileBased}">
                    <TextBlock Classes="label" Text="Database file" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding FilePath}" PlaceholderText="/path/to/database.db" />
                        <Button Grid.Column="1" Content="Browse…" Margin="6 0 0 0" Classes="toolbar"
                                Command="{Binding BrowseFileCommand}" />
                    </Grid>
                </StackPanel>

                <!-- Server-based engines -->
                <StackPanel Spacing="14" IsVisible="{Binding IsServerBased}">
                    <Grid ColumnDefinitions="*,110">
                        <StackPanel Grid.Column="0" Spacing="5" Margin="0 0 8 0">
                            <TextBlock Classes="label" Text="Host" />
                            <TextBox Text="{Binding Host}" PlaceholderText="localhost" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Classes="label" Text="Port" />
                            <TextBox Text="{Binding Port}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="5">
                        <TextBlock Classes="label" Text="Database" />
                        <TextBox Text="{Binding Database}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="5" Margin="0 0 8 0">
                            <TextBlock Classes="label" Text="Username" />
                            <TextBox Text="{Binding Username}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Classes="label" Text="Password" />
                            <TextBox Text="{Binding Password}" PasswordChar="•" Classes="revealPasswordButton" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0 -6 0 0" Opacity="0.6">
                        <c:Icon Kind="lock" Size="13" Foreground="#4EC977" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PasswordStorageText}" FontSize="11" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Spacing="5">
                        <TextBlock Classes="label" Text="SSL mode" />
                        <ComboBox ItemsSource="{Binding SslModes}" SelectedItem="{Binding SslMode}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>
                </StackPanel>

                <!-- Color swatches -->
                <StackPanel Spacing="6">
                    <TextBlock Classes="label" Text="Accent color (marks the connection in the sidebar)" />
                    <ItemsControl ItemsSource="{Binding ColorSwatches}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ColorSwatch">
                                <Button Classes="swatch" Classes.selected="{Binding IsSelected}"
                                        Background="{Binding Hex}" ToolTip.Tip="{Binding Hex}"
                                        Command="{Binding $parent[ItemsControl].((vm:ConnectionEditorViewModel)DataContext).SelectColorCommand}"
                                        CommandParameter="{Binding Hex}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Test result: pinned above the buttons (outside the scroll area) so it's always seen -->
        <Border Grid.Row="2" Padding="12 10" Margin="22 4 22 12" CornerRadius="6" Background="#252526"
                BorderBrush="#3F3F46" BorderThickness="1" IsVisible="{Binding HasTestMessage}">
            <Grid ColumnDefinitions="Auto,*">
                <c:Icon Kind="{Binding TestIcon}" Size="16" VerticalAlignment="Top" Margin="0 1 10 0"
                        Foreground="{Binding TestColor}" />
                <SelectableTextBlock Grid.Column="1" Text="{Binding TestMessage}" TextWrapping="Wrap" MaxHeight="120"
                                     Foreground="{Binding TestColor}" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0 1 0 0" Padding="22 12">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <Button Grid.Column="0" Command="{Binding TestCommand}" IsEnabled="{Binding !IsBusy}" Classes="toolbar">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:Icon Kind="link" Size="14" />
                        <TextBlock Text="Test Connection" />
                    </StackPanel>
                </Button>
                <ProgressBar Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                             Width="60" MinWidth="0" Height="3" Margin="10 0 0 0" VerticalAlignment="Center" />
                <Button Grid.Column="3" Content="Cancel" Name="CancelButton" Classes="toolbar" Margin="0 0 8 0"
                        MinWidth="84" HorizontalContentAlignment="Center" />
                <Button Grid.Column="4" Content="Save" Name="SaveButton" Classes="toolbar accent"
                        MinWidth="84" HorizontalContentAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
