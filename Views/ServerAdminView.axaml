<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nexus.ViewModels"
             xmlns:c="using:Nexus.Controls"
             x:Class="Nexus.Views.ServerAdminView"
             x:DataType="vm:ServerAdminViewModel">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="#252526" Padding="8 6" BorderBrush="#3F3F46" BorderThickness="0 0 0 1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <c:Icon Kind="server" Size="15" Opacity="0.7" VerticalAlignment="Center" Margin="4 0 0 0" />
                <TextBlock Text="SERVER ADMINISTRATION" FontSize="11" FontWeight="Bold"
                           Opacity="0.7" VerticalAlignment="Center" />
                <Button Classes="toolbar" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="refresh" Size="14" /><TextBlock Text="Refresh" /></StackPanel>
                </Button>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="80" Height="3"
                             VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Background="#1E1E1E">
            <TabItem Header="Sessions" IsVisible="{Binding SupportsSessions}">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="6">
                        <Button Classes="toolbar danger" Command="{Binding KillSessionCommand}"
                                IsVisible="{Binding SupportsKill}">
                            <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="ban" Size="14" Foreground="#F87171" /><TextBlock Text="Kill Session" /></StackPanel>
                        </Button>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Sessions}"
                              SelectedItem="{Binding SelectedSession}"
                              AutoGenerateColumns="False" IsReadOnly="True" FontSize="12"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="Auto" />
                            <DataGridTextColumn Header="User" Binding="{Binding User}" Width="Auto" />
                            <DataGridTextColumn Header="Database" Binding="{Binding Database}" Width="Auto" />
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="Auto" />
                            <DataGridTextColumn Header="Duration (ms)" Binding="{Binding DurationMs}" Width="Auto" />
                            <DataGridTextColumn Header="Query" Binding="{Binding QueryPreview}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Users" IsVisible="{Binding SupportsUsers}">
                <DataGrid ItemsSource="{Binding Users}" AutoGenerateColumns="False" IsReadOnly="True"
                          FontSize="12" GridLinesVisibility="Horizontal" Margin="6">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="Auto" />
                        <DataGridCheckBoxColumn Header="Admin" Binding="{Binding IsAdmin}" Width="Auto" />
                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Table Sizes">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="6">
                        <TextBlock Text="Container:" VerticalAlignment="Center" Opacity="0.7" />
                        <ComboBox MinWidth="160" ItemsSource="{Binding Containers}"
                                  SelectedItem="{Binding SelectedContainer}" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding TableStats}" AutoGenerateColumns="False"
                              IsReadOnly="True" FontSize="12" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Table" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Rows (est.)" Binding="{Binding RowEstimate}" Width="Auto" />
                            <DataGridTextColumn Header="Size" Binding="{Binding TotalSize}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Variables">
                <Grid RowDefinitions="Auto,*">
                    <TextBox Grid.Row="0" Margin="6" PlaceholderText="Filter variables…"
                             Text="{Binding VariableFilter}" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Variables}" AutoGenerateColumns="False"
                              IsReadOnly="True" FontSize="12" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="Auto" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#252526" Padding="10 5" BorderBrush="#3F3F46" BorderThickness="0 1 0 0">
            <TextBlock Text="{Binding StatusText}" Opacity="0.85" FontSize="12" />
        </Border>
    </Grid>
</UserControl>
