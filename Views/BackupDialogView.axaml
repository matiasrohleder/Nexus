<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nexus.ViewModels"
             xmlns:c="using:Nexus.Controls"
             x:Class="Nexus.Views.BackupDialogView"
             x:DataType="vm:BackupDialogViewModel">

    <!-- Backup / Restore: in-window overlay like the other dialogs (no OS windows; Wayland-safe). -->
    <Border Background="#B0101010" IsVisible="{Binding IsOpen}">
        <Border Width="600" MaxHeight="640" Background="#252526" CornerRadius="10" Padding="22 20"
                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                BorderBrush="#3F3F46" BorderThickness="1" BoxShadow="0 12 40 0 #80000000">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" >
                <!-- header -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0 0 0 16">
                    <Panel VerticalAlignment="Top" Margin="0 1 14 0">
                        <c:Icon Kind="save" Size="22" Foreground="#60A5FA" IsVisible="{Binding IsBackup}" />
                        <c:Icon Kind="history" Size="22" Foreground="#60A5FA" IsVisible="{Binding IsRestore}" />
                    </Panel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!-- options -->
                <StackPanel Grid.Row="1" Spacing="12" IsEnabled="{Binding CanEdit}">
                    <!-- tool status -->
                    <Border CornerRadius="6" Padding="10 8" Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Panel Margin="0 1 8 0" VerticalAlignment="Top">
                                <c:Icon Kind="check" Size="14" Foreground="#4ADE80" IsVisible="{Binding IsReady}" />
                                <c:Icon Kind="warning" Size="14" Foreground="#FBBF24" IsVisible="{Binding !IsReady}" />
                            </Panel>
                            <SelectableTextBlock Grid.Column="1" Text="{Binding Readiness.Detail}" TextWrapping="Wrap"
                                                 FontSize="12" LineHeight="18" Opacity="0.85" />
                            <Button Grid.Column="2" Classes="toolbar" Content="{Binding LocateToolText}" Margin="8 0 0 0"
                                    VerticalAlignment="Top" Command="{Binding LocateToolCommand}"
                                    IsVisible="{Binding CanLocateTool}"
                                    ToolTip.Tip="Pick the executable to use (e.g. a newer version, or one installed somewhere Nexus doesn't look)" />
                        </Grid>
                    </Border>

                    <StackPanel Spacing="6" IsVisible="{Binding IsReady}">
                        <TextBlock Text="{Binding PathLabel}" FontSize="12" Opacity="0.7" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Text="{Binding Path}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                            <Button Grid.Column="1" Classes="toolbar" Content="Browse…" Margin="6 0 0 0"
                                    Command="{Binding BrowseCommand}" IsVisible="{Binding CanBrowse}" />
                        </Grid>
                        <TextBlock Text="The path is on the database server, not on this computer."
                                   FontSize="11" Opacity="0.55" IsVisible="{Binding IsServerPath}" />
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding HasFormatChoice}">
                        <TextBlock Text="Format" FontSize="12" Opacity="0.7" />
                        <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding FormatChoice}" MinWidth="260" />
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding ShowTargetDatabase}">
                        <TextBlock Text="Restore into database (created if it doesn't exist)" FontSize="12" Opacity="0.7" />
                        <TextBox Text="{Binding TargetDatabase}" />
                    </StackPanel>

                    <StackPanel Spacing="2" IsVisible="{Binding ShowReplace}">
                        <CheckBox Content="Replace existing data" IsChecked="{Binding Replace}" />
                        <TextBlock Text="{Binding ReplaceHint}" TextWrapping="Wrap" FontSize="11" Opacity="0.55"
                                   Margin="28 0 0 0" />
                    </StackPanel>
                </StackPanel>

                <!-- live log -->
                <TextBox Grid.Row="2" Text="{Binding LogText}" IsReadOnly="True" AcceptsReturn="True"
                         IsVisible="{Binding HasLog}" MinHeight="140" Margin="0 14 0 0"
                         FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap"
                         Background="#1E1E1E" BorderThickness="0" CaretIndex="{Binding LogText.Length}" />

                <!-- progress / outcome -->
                <StackPanel Grid.Row="3" Spacing="8" Margin="0 12 0 0">
                    <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsRunning}" />
                    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasOutcome}">
                        <Panel Margin="0 1 8 0" VerticalAlignment="Top">
                            <c:Icon Kind="check" Size="14" Foreground="#4ADE80" IsVisible="{Binding Succeeded}" />
                            <c:Icon Kind="error" Size="14" Foreground="#F87171" IsVisible="{Binding !Succeeded}" />
                        </Panel>
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Outcome}" TextWrapping="Wrap" FontSize="13" />
                    </Grid>
                </StackPanel>

                <!-- buttons -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0 16 0 0">
                    <Button Content="Cancel" MinWidth="88" Classes="toolbar" HorizontalContentAlignment="Center"
                            Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
                    <Button Content="Close" MinWidth="88" Classes="toolbar" HorizontalContentAlignment="Center"
                            Command="{Binding CloseCommand}" IsVisible="{Binding !IsRunning}" />
                    <Button Content="{Binding StartText}" MinWidth="96" Classes="toolbar accent"
                            HorizontalContentAlignment="Center" Command="{Binding StartCommand}"
                            IsVisible="{Binding IsReady}" />
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</UserControl>
