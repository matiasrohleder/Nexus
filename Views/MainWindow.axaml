<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Nexus.ViewModels"
        xmlns:c="using:Nexus.Controls"
        x:Class="Nexus.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1280" Height="800" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/nexus.ico"
        Background="#1E1E1E"
        Title="Nexus">

    <Window.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding RunActiveCommand}" />
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding RunActiveCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewQueryCommand}" />
    </Window.KeyBindings>

    <Panel>
    <DockPanel>
        <!-- Title bar / global toolbar -->
        <Border DockPanel.Dock="Top" Background="#181818" Padding="12 7"
                BorderBrush="#3F3F46" BorderThickness="0 0 0 1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <Image Source="/Assets/nexus-256.png" Width="22" Height="22"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <TextBlock Text="Nexus" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding VersionText}" FontSize="12" Opacity="0.5"
                               VerticalAlignment="Center" Margin="0 2 0 0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Classes="toolbar" Command="{Binding NewQueryCommand}" ToolTip.Tip="New query (Ctrl+N)">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <c:Icon Kind="query" Size="15" />
                            <TextBlock Text="New Query" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main split: sidebar | editors + profiler. Columns swapped in code-behind per side. -->
        <Grid Name="MainSplitGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="180" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Object Explorer -->
            <Border Name="SidebarPanel" Grid.Column="0" Background="#252526">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="12 6 6 6" BorderBrush="#3F3F46" BorderThickness="0 0 0 1">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="CONNECTIONS" FontSize="11"
                                       FontWeight="Bold" Opacity="0.6" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="1">
                                <Button Classes="icon" ToolTip.Tip="Add connection" Command="{Binding AddConnectionCommand}">
                                    <c:Icon Kind="plus" Size="16" />
                                </Button>
                                <Button Classes="icon" ToolTip.Tip="Edit selected connection" Command="{Binding EditConnectionCommand}">
                                    <c:Icon Kind="edit" Size="15" />
                                </Button>
                                <Button Classes="icon" ToolTip.Tip="Refresh" Command="{Binding RefreshConnectionCommand}">
                                    <c:Icon Kind="refresh" Size="15" />
                                </Button>
                                <Button Classes="icon" ToolTip.Tip="Remove selected connection" Command="{Binding RemoveConnectionCommand}">
                                    <c:Icon Kind="trash" Size="15" />
                                </Button>
                                <Button Classes="icon" ToolTip.Tip="More">
                                    <c:Icon Kind="more" Size="16" StrokeThickness="3" />
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuItem Header="Import connections…" Command="{Binding ImportConnectionsCommand}">
                                                <MenuItem.Icon><c:Icon Kind="import" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Export connections…" Command="{Binding ExportConnectionsCommand}">
                                                <MenuItem.Icon><c:Icon Kind="export" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Open data folder" Command="{Binding OpenDataFolderCommand}">
                                                <MenuItem.Icon><c:Icon Kind="open" /></MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Move sidebar to the other side" Command="{Binding ToggleSidebarSideCommand}">
                                                <MenuItem.Icon><c:Icon Kind="swap" /></MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="About Nexus" Command="{Binding ShowAboutCommand}">
                                                <MenuItem.Icon><c:Icon Kind="info" /></MenuItem.Icon>
                                            </MenuItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- First-run hint when there are no connections yet -->
                    <StackPanel Grid.Row="1" IsVisible="{Binding !HasConnections}" Margin="16 24" Spacing="10">
                        <TextBlock Text="No connections yet" FontWeight="SemiBold" Opacity="0.8" />
                        <TextBlock Text="Add one to browse databases, run queries and administer servers."
                                   TextWrapping="Wrap" Opacity="0.55" FontSize="12" />
                        <Button Classes="toolbar accent" HorizontalAlignment="Left" Command="{Binding AddConnectionCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <c:Icon Kind="plus" Size="14" />
                                <TextBlock Text="Add connection" />
                            </StackPanel>
                        </Button>
                        <Button Classes="toolbar" HorizontalAlignment="Left" Command="{Binding ImportConnectionsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <c:Icon Kind="import" Size="14" />
                                <TextBlock Text="Import connections…" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TreeView Grid.Row="1" Name="ExplorerTree"
                              x:CompileBindings="False"
                              ItemsSource="{Binding ConnectionNodes}"
                              SelectedItem="{Binding SelectedNode}"
                              Background="Transparent" Padding="0 4">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="View Data (top 100)" Command="{Binding OpenTableCommand}"
                                          CommandParameter="{Binding SelectedNode}">
                                    <MenuItem.Icon><c:Icon Kind="search" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Edit Data" Command="{Binding EditTableDataCommand}"
                                          CommandParameter="{Binding SelectedNode}">
                                    <MenuItem.Icon><c:Icon Kind="edit" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="View DDL" Command="{Binding ViewDdlCommand}"
                                          CommandParameter="{Binding SelectedNode}">
                                    <MenuItem.Icon><c:Icon Kind="code" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Import CSV…" Command="{Binding ImportCsvCommand}"
                                          CommandParameter="{Binding SelectedNode}">
                                    <MenuItem.Icon><c:Icon Kind="import" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Truncate Table…" Command="{Binding TruncateTableCommand}"
                                          CommandParameter="{Binding SelectedNode}">
                                    <MenuItem.Icon><c:Icon Kind="warning" Foreground="#FBBF24" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Drop…" Command="{Binding DropObjectCommand}"
                                          CommandParameter="{Binding SelectedNode}">
                                    <MenuItem.Icon><c:Icon Kind="trash" Foreground="#F87171" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Server Administration" Command="{Binding OpenServerAdminCommand}"
                                          CommandParameter="{Binding SelectedNode}">
                                    <MenuItem.Icon><c:Icon Kind="server" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Refresh" Command="{Binding RefreshConnectionCommand}">
                                    <MenuItem.Icon><c:Icon Kind="refresh" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="MinHeight" Value="28" />
                            </Style>
                        </TreeView.Styles>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:TreeNodeViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="7" Margin="0 2">
                                    <Border IsVisible="{Binding HasBadge}" Width="3" Height="16" CornerRadius="1.5"
                                            Background="{Binding AccentColor}" VerticalAlignment="Center" />
                                    <Border IsVisible="{Binding HasBadge}" Classes="badge" Background="{Binding BadgeColor}">
                                        <TextBlock Text="{Binding Badge}" />
                                    </Border>
                                    <c:Icon IsVisible="{Binding HasIcon}" Kind="{Binding Icon}" Foreground="{Binding IconColor}"
                                            Size="15" StrokeThickness="1.8" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Detail}" IsVisible="{Binding HasDetail}" FontSize="12"
                                               Opacity="0.45" VerticalAlignment="Center" />
                                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}"
                                                 Width="36" Height="2" MinWidth="0" VerticalAlignment="Center" />
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Name="MainSplitter" Grid.Column="1" Width="4" Background="#2B2B2F" />

            <!-- Editors (top) + Profiler (bottom) -->
            <Grid Name="ContentPanel" Grid.Column="2" RowDefinitions="*,4,240">

                <!-- Query tabs -->
                <Panel Grid.Row="0">
                    <TabControl ItemsSource="{Binding Documents}"
                                SelectedItem="{Binding SelectedDocument}"
                                Background="#1E1E1E" Padding="0">
                        <TabControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DocumentViewModel" x:CompileBindings="False">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <c:Icon Kind="{Binding Icon}" Size="14" Opacity="0.75" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                    <Button Classes="icon" Padding="3" Margin="2 0 -6 0" ToolTip.Tip="Close tab"
                                            Command="{Binding DataContext.CloseDocumentCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                            CommandParameter="{Binding}">
                                        <c:Icon Kind="close" Size="12" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                    </TabControl>

                    <!-- Empty state -->
                    <StackPanel IsVisible="{Binding !HasDocuments}" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="10">
                        <Image Source="/Assets/nexus-256.png" Width="72" Height="72" Opacity="0.9"
                               RenderOptions.BitmapInterpolationMode="HighQuality" Margin="0 0 0 6" />
                        <TextBlock Text="No queries open" FontSize="17" FontWeight="SemiBold" Opacity="0.85"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Add a connection, then press &quot;New Query&quot; or double-click a table."
                                   Opacity="0.5" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0 6 0 0">
                            <Button Classes="toolbar accent" Command="{Binding NewQueryCommand}" IsVisible="{Binding HasConnections}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <c:Icon Kind="query" Size="15" />
                                    <TextBlock Text="New Query" />
                                </StackPanel>
                            </Button>
                            <Button Classes="toolbar accent" Command="{Binding AddConnectionCommand}" IsVisible="{Binding !HasConnections}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <c:Icon Kind="plus" Size="15" />
                                    <TextBlock Text="Add connection" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="F5 / Ctrl+Enter run · Ctrl+Space autocomplete · Ctrl+N new query"
                                   FontSize="11" Opacity="0.35" HorizontalAlignment="Center" Margin="0 10 0 0" />
                    </StackPanel>
                </Panel>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#2B2B2F" />

                <!-- Bottom panel: Profiler | History | Snippets -->
                <Border Grid.Row="2" Background="#252526">
                    <TabControl Padding="0">
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <c:Icon Kind="clock" Size="14" />
                                    <TextBlock Text="Profiler" />
                                </StackPanel>
                            </TabItem.Header>
                            <Grid RowDefinitions="Auto,*" DataContext="{Binding Profiler}">
                                <Border Grid.Row="0" Padding="10 5" BorderBrush="#3F3F46" BorderThickness="0 0 0 1">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                                        <CheckBox Grid.Column="0" Content="Capture app queries"
                                                  IsChecked="{Binding IsCapturing}" VerticalAlignment="Center" />
                                        <CheckBox Grid.Column="1" Content="Server activity" Margin="12 0 6 0"
                                                  IsChecked="{Binding CaptureServerActivity}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="2" MinWidth="160" PlaceholderText="Connection"
                                                  ItemsSource="{Binding Connections}"
                                                  SelectedItem="{Binding ServerActivityConnection}"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding StatusText}" Opacity="0.55"
                                                   VerticalAlignment="Center" Margin="14 0" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="4" Content="Clear" Classes="toolbar"
                                                Command="{Binding ClearCommand}" />
                                    </Grid>
                                </Border>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Entries}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserResizeColumns="True" GridLinesVisibility="Horizontal"
                                          FontSize="12">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding TimestampText}" Width="Auto" />
                                        <DataGridTextColumn Header="Src" Binding="{Binding SourceText}" Width="Auto" />
                                        <DataGridTextColumn Header="Connection" Binding="{Binding Connection}" Width="Auto" />
                                        <DataGridTextColumn Header="Database" Binding="{Binding Database}" Width="Auto" />
                                        <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="Auto" />
                                        <DataGridTextColumn Header="Rows" Binding="{Binding RowCountText}" Width="Auto" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="Auto" />
                                        <DataGridTextColumn Header="SQL" Binding="{Binding SqlPreview}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <c:Icon Kind="history" Size="14" />
                                    <TextBlock Text="History" />
                                </StackPanel>
                            </TabItem.Header>
                            <Grid RowDefinitions="Auto,*">
                                <Border Grid.Row="0" Padding="10 5" BorderBrush="#3F3F46" BorderThickness="0 0 0 1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Double-click a row to reopen the query" Opacity="0.55"
                                                   VerticalAlignment="Center" FontSize="12" />
                                        <Button Grid.Column="1" Content="Clear" Classes="toolbar" Command="{Binding ClearHistoryCommand}" />
                                    </Grid>
                                </Border>
                                <DataGrid Grid.Row="1" Name="HistoryGrid" ItemsSource="{Binding History}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          GridLinesVisibility="Horizontal" FontSize="12">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding TimestampText}" Width="Auto" />
                                        <DataGridTextColumn Header="Connection" Binding="{Binding Connection}" Width="Auto" />
                                        <DataGridCheckBoxColumn Header="OK" Binding="{Binding Success}" Width="Auto" />
                                        <DataGridTextColumn Header="ms" Binding="{Binding DurationMs}" Width="Auto" />
                                        <DataGridTextColumn Header="SQL" Binding="{Binding SqlPreview}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <c:Icon Kind="star" Size="14" />
                                    <TextBlock Text="Snippets" />
                                </StackPanel>
                            </TabItem.Header>
                            <Grid RowDefinitions="Auto,*">
                                <Border Grid.Row="0" Padding="10 5" BorderBrush="#3F3F46" BorderThickness="0 0 0 1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Double-click to open · save snippets with the star button in the query editor"
                                                   Opacity="0.55" VerticalAlignment="Center" FontSize="12" />
                                        <Button Grid.Column="1" Content="Delete" Classes="toolbar"
                                                Command="{Binding DeleteSnippetCommand}"
                                                CommandParameter="{Binding #SnippetsGrid.SelectedItem}" />
                                    </Grid>
                                </Border>
                                <DataGrid Grid.Row="1" Name="SnippetsGrid" ItemsSource="{Binding Snippets}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          GridLinesVisibility="Horizontal" FontSize="12">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" />
                                        <DataGridTextColumn Header="SQL" Binding="{Binding Sql}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>

    <!-- In-window confirmation overlay: no OS dialog windows, so it can never get lost
         behind the main window (Wayland-safe) and never deadlocks the UI. -->
    <Border Name="ConfirmOverlay" Background="#B0101010" IsVisible="False" ZIndex="1000">
        <Border MinWidth="360" MaxWidth="520" Background="#252526" CornerRadius="10" Padding="22 20"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="#3F3F46" BorderThickness="1"
                BoxShadow="0 12 40 0 #80000000">
            <StackPanel Spacing="18">
                <Grid ColumnDefinitions="Auto,*">
                    <c:Icon Name="OverlayIcon" Kind="info" Size="22" Foreground="#60A5FA"
                            VerticalAlignment="Top" Margin="0 0 14 0" />
                    <SelectableTextBlock Grid.Column="1" Name="ConfirmText" TextWrapping="Wrap" FontSize="14"
                                         LineHeight="21" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Name="OverlayCancelButton" Content="Cancel" MinWidth="88" Classes="toolbar"
                            HorizontalContentAlignment="Center" />
                    <Button Name="OverlayOkButton" Content="Confirm" MinWidth="88" Classes="toolbar accent"
                            HorizontalContentAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
    </Panel>
</Window>
