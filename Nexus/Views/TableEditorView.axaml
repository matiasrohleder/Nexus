<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nexus.ViewModels"
             x:Class="Nexus.Views.TableEditorView"
             x:DataType="vm:TableEditorViewModel">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#252526" Padding="8 6" BorderBrush="#3F3F46" BorderThickness="0 0 0 1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="＋ Add Row" Classes="toolbar" Command="{Binding AddRowCommand}"
                        IsEnabled="{Binding !IsReadOnly}" />
                <Button Content="🗑 Delete Row" Classes="toolbar" Command="{Binding DeleteRowCommand}"
                        IsEnabled="{Binding !IsReadOnly}" />
                <Separator Width="1" Height="20" Background="#3F3F46" />
                <Button Content="💾 Commit" Classes="toolbar accent" Command="{Binding CommitCommand}"
                        IsEnabled="{Binding !IsReadOnly}" />
                <Button Content="↶ Revert" Classes="toolbar" Command="{Binding RevertCommand}" />
                <Button Content="⟳ Refresh" Classes="toolbar" Command="{Binding LoadCommand}" />
            </StackPanel>
        </Border>

        <!-- Editable grid (columns built in code-behind from runtime schema) -->
        <DataGrid Grid.Row="1" Name="EditGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="{Binding IsReadOnly}"
                  SelectedItem="{Binding SelectedRow}"
                  CanUserResizeColumns="True" CanUserSortColumns="False"
                  GridLinesVisibility="All"
                  FontFamily="Cascadia Code,Consolas,monospace" FontSize="13" />

        <!-- Status -->
        <Border Grid.Row="2" Background="#252526" Padding="10 5" BorderBrush="#3F3F46" BorderThickness="0 1 0 0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Opacity="0.85" FontSize="12" />
                <ProgressBar Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                             Width="90" Height="3" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
