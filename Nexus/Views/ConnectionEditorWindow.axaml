<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Nexus.ViewModels"
        xmlns:prov="using:Nexus.Providers"
        x:Class="Nexus.Views.ConnectionEditorWindow"
        x:DataType="vm:ConnectionEditorViewModel"
        Width="520" Height="720"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#1E1E1E"
        Title="{Binding DialogTitle}">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <TextBlock Grid.Row="0" Text="{Binding DialogTitle}"
                   FontSize="18" FontWeight="SemiBold" Margin="0 0 0 12" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">

                <!-- Engine tiles -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Database engine" Opacity="0.8" />
                    <ListBox ItemsSource="{Binding Engines}"
                             SelectedItem="{Binding SelectedEngine}"
                             Background="Transparent" Padding="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0 0 8 8" />
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="prov:IDatabaseProvider">
                                <StackPanel Orientation="Vertical" Width="86" Height="58" Spacing="2"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Glyph}" FontSize="20" HorizontalAlignment="Center"
                                               Margin="0 6 0 0" />
                                    <TextBlock Text="{Binding DisplayName}" FontSize="11"
                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- Paste URL -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Quick fill — paste a connection URL or string" Opacity="0.8" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding PasteUrl}"
                                 Watermark="postgres://user:pass@host:5432/db   ·   Host=…;Port=…;Database=…" />
                        <Button Grid.Column="1" Content="Apply" Margin="6 0 0 0" Classes="toolbar"
                                Command="{Binding ApplyPastedUrlCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding PasteUrlError}" Foreground="#F48771" FontSize="12"
                               IsVisible="{Binding PasteUrlError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <Separator Background="#3F3F46" Height="1" />

                <StackPanel Spacing="4">
                    <TextBlock Text="Name" Opacity="0.8" />
                    <TextBox Text="{Binding Name}" Watermark="Auto-generated if left empty" />
                </StackPanel>

                <!-- File-based engines: file picker -->
                <StackPanel Spacing="4" IsVisible="{Binding IsFileBased}">
                    <TextBlock Text="Database file" Opacity="0.8" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding FilePath}" Watermark="/path/to/database.db" />
                        <Button Grid.Column="1" Content="Browse…" Margin="6 0 0 0" Classes="toolbar"
                                Command="{Binding BrowseFileCommand}" />
                    </Grid>
                </StackPanel>

                <!-- Server-based engines -->
                <StackPanel Spacing="12" IsVisible="{Binding IsServerBased}">
                    <Grid ColumnDefinitions="*,90">
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0 0 8 0">
                            <TextBlock Text="Host" Opacity="0.8" />
                            <TextBox Text="{Binding Host}" Watermark="localhost" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Port" Opacity="0.8" />
                            <TextBox Text="{Binding Port}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Database" Opacity="0.8" />
                        <TextBox Text="{Binding Database}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0 0 8 0">
                            <TextBlock Text="Username" Opacity="0.8" />
                            <TextBox Text="{Binding Username}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Password" Opacity="0.8" />
                            <TextBox Text="{Binding Password}" PasswordChar="•" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBlock Text="SSL Mode" Opacity="0.8" />
                        <ComboBox ItemsSource="{Binding SslModes}" SelectedItem="{Binding SslMode}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>
                </StackPanel>

                <!-- Color swatches -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Accent color" Opacity="0.8" />
                    <ItemsControl ItemsSource="{Binding ColorSwatches}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String" x:CompileBindings="False">
                                <Button Width="26" Height="26" CornerRadius="13" Padding="0"
                                        Background="{Binding}"
                                        Command="{Binding $parent[ItemsControl].DataContext.SelectColorCommand}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Test result -->
                <Border Padding="10" CornerRadius="4" Background="#252526"
                        IsVisible="{Binding HasTestMessage}">
                    <TextBlock Text="{Binding TestMessage}" TextWrapping="Wrap"
                               Foreground="{Binding TestSucceeded, Converter={x:Static vm:BoolBrushes.Instance}}" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0 14 0 0">
            <Button Grid.Column="0" Content="Test Connection"
                    Command="{Binding TestCommand}" IsEnabled="{Binding !IsBusy}" Classes="toolbar" />
            <Button Grid.Column="2" Content="Cancel" Name="CancelButton" Classes="toolbar" Margin="0 0 8 0" />
            <Button Grid.Column="3" Content="Save" Name="SaveButton" Classes="toolbar accent" />
        </Grid>
    </Grid>
</Window>
