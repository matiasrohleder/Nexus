<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Nexus.ViewModels"
        x:Class="Nexus.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1280" Height="800"
        Background="#1E1E1E"
        Title="Nexus">

    <Window.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding RunActiveCommand}" />
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding RunActiveCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewQueryCommand}" />
    </Window.KeyBindings>

    <Panel>
    <DockPanel>
        <!-- Title bar / global toolbar -->
        <Border DockPanel.Dock="Top" Background="#181818" Padding="12 8"
                BorderBrush="#3F3F46" BorderThickness="0 0 0 1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="⬡" FontSize="18" Foreground="#3B82F6" VerticalAlignment="Center" />
                    <TextBlock Text="Nexus" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding VersionText}" FontSize="12" Opacity="0.5"
                               VerticalAlignment="Center" Margin="2 3 0 0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="⧉ New Query" Classes="toolbar" Command="{Binding NewQueryCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main split: sidebar | editors + profiler. Columns swapped in code-behind per side. -->
        <Grid Name="MainSplitGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="180" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Object Explorer -->
            <Border Name="SidebarPanel" Grid.Column="0" Background="#252526">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="10 8" BorderBrush="#3F3F46" BorderThickness="0 0 0 1">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="CONNECTIONS" FontSize="11"
                                       FontWeight="Bold" Opacity="0.6" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                <Button Content="＋" ToolTip.Tip="Add connection" Padding="6 2"
                                        Background="Transparent" Command="{Binding AddConnectionCommand}" />
                                <Button Content="✎" ToolTip.Tip="Edit selected" Padding="6 2"
                                        Background="Transparent" Command="{Binding EditConnectionCommand}" />
                                <Button Content="⟳" ToolTip.Tip="Refresh" Padding="6 2"
                                        Background="Transparent" Command="{Binding RefreshConnectionCommand}" />
                                <Button Content="🗑" ToolTip.Tip="Remove selected" Padding="6 2"
                                        Background="Transparent" Command="{Binding RemoveConnectionCommand}" />
                                <Button Content="⇄" ToolTip.Tip="Move sidebar to the other side" Padding="6 2"
                                        Background="Transparent" Command="{Binding ToggleSidebarSideCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TreeView Grid.Row="1" Name="ExplorerTree"
                              x:CompileBindings="False"
                              ItemsSource="{Binding ConnectionNodes}"
                              SelectedItem="{Binding SelectedNode}"
                              Background="Transparent">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="🔍 View Data (top 100)" Command="{Binding OpenTableCommand}"
                                          CommandParameter="{Binding SelectedNode}" />
                                <MenuItem Header="✎ Edit Data" Command="{Binding EditTableDataCommand}"
                                          CommandParameter="{Binding SelectedNode}" />
                                <MenuItem Header="📜 View DDL" Command="{Binding ViewDdlCommand}"
                                          CommandParameter="{Binding SelectedNode}" />
                                <MenuItem Header="📥 Import CSV…" Command="{Binding ImportCsvCommand}"
                                          CommandParameter="{Binding SelectedNode}" />
                                <Separator />
                                <MenuItem Header="⚠ Truncate Table…" Command="{Binding TruncateTableCommand}"
                                          CommandParameter="{Binding SelectedNode}" />
                                <MenuItem Header="🗑 Drop…" Command="{Binding DropObjectCommand}"
                                          CommandParameter="{Binding SelectedNode}" />
                                <Separator />
                                <MenuItem Header="🖥 Server Administration" Command="{Binding OpenServerAdminCommand}"
                                          CommandParameter="{Binding SelectedNode}" />
                                <MenuItem Header="⟳ Refresh" Command="{Binding RefreshConnectionCommand}" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.Styles>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:TreeNodeViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0 2">
                                    <TextBlock Text="{Binding Glyph}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}"
                                                 Width="36" Height="2" VerticalAlignment="Center" />
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Name="MainSplitter" Grid.Column="1" Width="4" Background="#3F3F46" />

            <!-- Editors (top) + Profiler (bottom) -->
            <Grid Name="ContentPanel" Grid.Column="2" RowDefinitions="*,4,260">

                <!-- Query tabs -->
                <Panel Grid.Row="0">
                    <TabControl ItemsSource="{Binding Documents}"
                                SelectedItem="{Binding SelectedDocument}"
                                Background="#1E1E1E">
                        <TabControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:QueryDocumentViewModel" x:CompileBindings="False">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                    <Button Content="✕" Padding="4 0" FontSize="11" Background="Transparent"
                                            Command="{Binding DataContext.CloseDocumentCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                    </TabControl>

                    <!-- Empty state -->
                    <StackPanel IsVisible="{Binding !HasDocuments}" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="10">
                        <TextBlock Text="⬡" FontSize="48" Foreground="#3B82F6" HorizontalAlignment="Center" Opacity="0.6" />
                        <TextBlock Text="No queries open" FontSize="16" Opacity="0.7" HorizontalAlignment="Center" />
                        <TextBlock Text="Add a connection, then press &quot;New Query&quot; or double-click a table."
                                   Opacity="0.5" HorizontalAlignment="Center" />
                        <Button Content="⧉ New Query" Classes="toolbar accent" HorizontalAlignment="Center"
                                Command="{Binding NewQueryCommand}" />
                    </StackPanel>
                </Panel>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#3F3F46" />

                <!-- Bottom panel: Profiler | History | Snippets -->
                <Border Grid.Row="2" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0 1 0 0">
                    <TabControl Padding="0">
                        <TabItem Header="⏱ Profiler" FontSize="12">
                            <Grid RowDefinitions="Auto,*" DataContext="{Binding Profiler}">
                                <Border Grid.Row="0" Padding="10 4" BorderBrush="#3F3F46" BorderThickness="0 0 0 1">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                                        <CheckBox Grid.Column="0" Content="Capture app queries"
                                                  IsChecked="{Binding IsCapturing}" VerticalAlignment="Center" />
                                        <CheckBox Grid.Column="1" Content="Server activity" Margin="12 0 6 0"
                                                  IsChecked="{Binding CaptureServerActivity}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="2" MinWidth="150"
                                                  ItemsSource="{Binding Connections}"
                                                  SelectedItem="{Binding ServerActivityConnection}"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding StatusText}" Opacity="0.6"
                                                   VerticalAlignment="Center" Margin="14 0" />
                                        <Button Grid.Column="4" Content="Clear" Classes="toolbar"
                                                Command="{Binding ClearCommand}" />
                                    </Grid>
                                </Border>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Entries}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserResizeColumns="True" GridLinesVisibility="Horizontal"
                                          FontSize="12">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding TimestampText}" Width="Auto" />
                                        <DataGridTextColumn Header="Src" Binding="{Binding SourceText}" Width="Auto" />
                                        <DataGridTextColumn Header="Connection" Binding="{Binding Connection}" Width="Auto" />
                                        <DataGridTextColumn Header="Database" Binding="{Binding Database}" Width="Auto" />
                                        <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="Auto" />
                                        <DataGridTextColumn Header="Rows" Binding="{Binding RowCountText}" Width="Auto" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="Auto" />
                                        <DataGridTextColumn Header="SQL" Binding="{Binding SqlPreview}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="🕘 History" FontSize="12">
                            <Grid RowDefinitions="Auto,*">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="8 4">
                                    <TextBlock Text="Double-click to reopen a query" Opacity="0.5"
                                               VerticalAlignment="Center" FontSize="12" />
                                    <Button Content="Clear" Classes="toolbar" Command="{Binding ClearHistoryCommand}" />
                                </StackPanel>
                                <DataGrid Grid.Row="1" Name="HistoryGrid" ItemsSource="{Binding History}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          GridLinesVisibility="Horizontal" FontSize="12">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding TimestampText}" Width="Auto" />
                                        <DataGridTextColumn Header="Connection" Binding="{Binding Connection}" Width="Auto" />
                                        <DataGridCheckBoxColumn Header="OK" Binding="{Binding Success}" Width="Auto" />
                                        <DataGridTextColumn Header="ms" Binding="{Binding DurationMs}" Width="Auto" />
                                        <DataGridTextColumn Header="SQL" Binding="{Binding SqlPreview}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="★ Snippets" FontSize="12">
                            <Grid RowDefinitions="Auto,*">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="8 4">
                                    <TextBlock Text="Double-click to open — save snippets from the query editor (★)"
                                               Opacity="0.5" VerticalAlignment="Center" FontSize="12" />
                                    <Button Content="Delete" Classes="toolbar"
                                            Command="{Binding DeleteSnippetCommand}"
                                            CommandParameter="{Binding #SnippetsGrid.SelectedItem}" />
                                </StackPanel>
                                <DataGrid Grid.Row="1" Name="SnippetsGrid" ItemsSource="{Binding Snippets}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          GridLinesVisibility="Horizontal" FontSize="12">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" />
                                        <DataGridTextColumn Header="SQL" Binding="{Binding Sql}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>

    <!-- In-window confirmation overlay: no OS dialog windows, so it can never get lost
         behind the main window (Wayland-safe) and never deadlocks the UI. -->
    <Border Name="ConfirmOverlay" Background="#B0101010" IsVisible="False" ZIndex="1000">
        <Border MaxWidth="480" Background="#252526" CornerRadius="8" Padding="20"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="#3F3F46" BorderThickness="1">
            <StackPanel Spacing="16">
                <SelectableTextBlock Name="ConfirmText" TextWrapping="Wrap" FontSize="14" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Name="OverlayCancelButton" Content="Cancel" MinWidth="84" Classes="toolbar" />
                    <Button Name="OverlayOkButton" Content="Confirm" MinWidth="84" Classes="toolbar accent" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
    </Panel>
</Window>
